<rml>
<head>
    <title>Poima native UI presentation example</title>
    <style>
        body {
            font-family: Poima UI;
            font-size: 18dp;
            color: #edf1f7;
            margin: 0;
            width: 100%;
            height: 100%;
        }
        div { display: block; }
        #status {
            position: absolute;
            left: 24dp;
            top: 24dp;
            width: 280dp;
            padding: 18dp;
            background-color: #151b24ed;
            border-left: 3dp #72d6b5;
        }
        #heading { color: #72d6b5; font-size: 13dp; margin-bottom: 12dp; }
        #health { font-size: 24dp; margin-bottom: 8dp; }
        #objective { color: #b6c2d2; font-size: 16dp; }
        #controls {
            position: absolute;
            left: 24dp;
            bottom: 24dp;
            padding: 14dp;
            background-color: #151b24ed;
        }
        button {
            display: inline-block;
            padding: 10dp 18dp;
            margin-right: 8dp;
            background-color: #293442;
            color: #edf1f7;
            border: 1dp #526174;
            tab-index: auto;
        }
        button:hover, button:focus { background-color: #36524f; border-color: #72d6b5; }
        button:disabled { color: #748092; background-color: #1b232e; }
    </style>
</head>
<body>
    <div id="status">
        <div id="heading">EXPEDITION</div>
        <div id="health">Health 100 / 100</div>
        <div id="objective">Find the survey marker</div>
    </div>
    <div id="controls">
        <button id="continue">Continue</button>
        <button id="save">Save</button>
    </div>
</body>
</rml>
