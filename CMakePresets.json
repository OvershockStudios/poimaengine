{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Native bootstrap with Vulkan inspection",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "headless",
      "displayName": "Headless world service (no dependency downloads)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "POIMA_ENABLE_VULKAN_PROBE": "OFF"
      }
    },
    {
      "name": "windows-render",
      "displayName": "WSL cross-build: native Windows Vulkan experiment",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/windows-render",
      "toolchainFile": "${sourceDir}/cmake/windows-llvm-mingw.cmake",
      "cacheVariables": {
        "POIMA_BUILD_RENDER_SMOKE": "ON",
        "POIMA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "runtime-headless",
      "displayName": "Headless Jolt/EnTT runtime",
      "inherits": "headless",
      "binaryDir": "${sourceDir}/build/runtime-headless",
      "cacheVariables": {
        "POIMA_ENABLE_SIMULATION": "ON"
      }
    },
    {
      "name": "windows-runtime",
      "displayName": "Native Windows runtime and Vulkan preview",
      "inherits": "windows-render",
      "binaryDir": "${sourceDir}/build/windows-runtime",
      "cacheVariables": {
        "POIMA_ENABLE_SIMULATION": "ON"
      }
    },
    {
      "name": "linux-game",
      "displayName": "Linux headless game authoring and simulation",
      "inherits": "runtime-headless",
      "binaryDir": "${sourceDir}/build/linux-game",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "POIMA_ENABLE_NATIVE_GAMEPLAY": "ON",
        "POIMA_ENABLE_MANAGED_GAMEPLAY": "ON",
        "POIMA_ENABLE_NAVIGATION": "ON",
        "POIMA_ENABLE_AUDIO": "ON",
        "POIMA_ENABLE_GAME_UI": "ON",
        "POIMA_DOTNET_HOST_HEADERS": "${sourceDir}/.cache/toolchains/dotnet-10.0.401/packs/Microsoft.NETCore.App.Host.linux-x64/10.0.12/runtimes/linux-x64/native",
        "POIMA_BUILD_MODULE_LAB": "OFF",
        "POIMA_USE_THIN_ARCHIVES": "OFF",
        "POIMA_BUILD_RENDER_SMOKE": "OFF",
        "POIMA_BUILD_EDITOR": "OFF",
        "POIMA_BUILD_DESKTOP_BRIDGE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 2
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "jobs": 2
    },
    {
      "name": "windows-render",
      "configurePreset": "windows-render",
      "jobs": 2
    },
    {
      "name": "runtime-headless",
      "configurePreset": "runtime-headless",
      "jobs": 2
    },
    {
      "name": "windows-runtime",
      "configurePreset": "windows-runtime",
      "jobs": 2
    },
    {
      "name": "linux-game",
      "configurePreset": "linux-game",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "runtime-headless",
      "configurePreset": "runtime-headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-game",
      "configurePreset": "linux-game",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
