<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>0.0.26</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.6" />
    <PackageReference Include="Dock.Avalonia.Themes.Simple" Version="12.1.0.6" />
    <AvaloniaResource Include="../../third_party/inter/Inter-Regular.ttf" Link="Assets/Inter-Regular.ttf" />
    <AvaloniaResource Include="../../third_party/inter/Inter-SemiBold.ttf" Link="Assets/Inter-SemiBold.ttf" />
  </ItemGroup>
</Project>
