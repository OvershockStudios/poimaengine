<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PoimaSourceRoot Condition="'$(PoimaSourceRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</PoimaSourceRoot>
  </PropertyGroup>
  <Import Project="$(PoimaSourceRoot)/managed/Directory.Build.props" />
  <ItemGroup Condition="'$(PoimaGameplayAssembly)' == ''">
    <ProjectReference Include="$(PoimaSourceRoot)/managed/Poima.Gameplay/Poima.Gameplay.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(PoimaGameplayAssembly)' != ''">
    <Reference Include="Poima.Gameplay"><HintPath>$(PoimaGameplayAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>
