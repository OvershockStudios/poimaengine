<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PoimaEditorDirectory Condition="'$(PoimaEditorDirectory)' == ''">$(MSBuildThisFileDirectory)__explicit_editor_directory_required__</PoimaEditorDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Poima.Editor">
      <HintPath>$(PoimaEditorDirectory)/Poima.Editor.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireBuiltEditor" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PoimaEditorDirectory)/Poima.Editor.dll')" Text="Pass -p:PoimaEditorDirectory with an existing, separately qualified complete editor build directory." />
  </Target>
</Project>
