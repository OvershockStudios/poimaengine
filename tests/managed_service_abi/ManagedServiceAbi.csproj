<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BridgeDirectory Condition="'$(BridgeDirectory)' == ''">$(MSBuildThisFileDirectory)../../managed/Poima.ManagedBridge/bin/Release/net10.0</BridgeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Poima.ManagedBridge"><HintPath>$(BridgeDirectory)/Poima.ManagedBridge.dll</HintPath></Reference>
    <Reference Include="Poima.Gameplay"><HintPath>$(BridgeDirectory)/Poima.Gameplay.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup><Compile Include="../components_gameplay/ComponentGame.cs" Link="ComponentGame.cs" /></ItemGroup>
  <Import Project="../../managed/Poima.Components.targets" />
</Project>
