  "desktop_checks": [
    "Separate visible Scene and Game HWNDs render independently; navigating Scene preserves exact Game image bytes.",
    "Real native character move/jump/look from semantic Game messages leaves the Scene camera unchanged.",
    "Focus/Pause/resize/floating release held controls; shared stepping presents the same simulation tick in both panes.",
    "Deleted or absent Game camera hides stale pixels; Scene continues presenting and repaired Game recovers.",
    "Floating both panes, restoring layouts and a fresh-process restart preserve native state and authored content.",
    "Narrow Inspector vector/color fields retain usable widths; existing sky editing verifies draft/Apply/Undo behavior."
  ],
  "screenshot": {
    "path": "m2-desktop-dual-view.png",
