  "experimental_branches": [
    {
      "method": "runtime.step",
      "parameter": "camera_lenses",
      "when": "nonempty-array"
    },
    {
      "method": "runtime.step",
      "parameter": "character_stances",
      "when": "nonempty-array"
    },
    {
      "method": "runtime.step",
      "parameter": "ik",
      "when": "nonempty-array"
    },
    {
      "method": "runtime.step",
      "parameter": "root_motion",
      "when": "nonempty-array"
    },
    {
      "method": "save.load",
      "parameter": "upgrade",
      "when": "present"
    }
  ],
  "defaults": {
    "runtime.component.query.limit": 64,
    "runtime.ui.inspect.limit": 64,
    "save.load.allow_recovery": false,
    "save.write.acknowledge_recovery": false
  },
  "retention_minima": {
    "runtime.step": {
      "count": 32,
      "lifetime": "owner-local",
      "outcomes": "accepted advances"
    },
    "runtime.ui.activate": {
      "count": 32,
      "lifetime": "owner-local",
      "outcomes": "accepted controls"
    },
    "save.load": {
      "count": 32,
      "lifetime": "owner-local-shared-outcome-pool",
      "shared_with": [
        "save.configure"
      ]
    },
    "save.write": {
      "count": 32,
      "lifetime": "durable-per-slot",
      "outcomes": "committed writes only"
    },
    "gameplay_terminal_ledger": {
      "count": 64,
      "lifetime": "owner-local"
    }
  },
  "error_codes": {
