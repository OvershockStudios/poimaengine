{
  "format": "poima.runtime",
  "version": 1,
  "engine_version": "@PROJECT_VERSION@",
  "gameplay_services_version": 7,
  "gameplay_call_version": 1,
  "gameplay_call_bytes": 80,
  "gameplay_services_bytes": 176,
  "gameplay_features": ["baseline_v7"],
  "target_os": "@CMAKE_SYSTEM_NAME@",
  "target_arch": "@POIMA_TARGET_ARCH@",
  "executable": "bin/poima@CMAKE_EXECUTABLE_SUFFIX@",
  "features": {
    "simulation": @POIMA_RUNTIME_SIMULATION@,
    "renderer": @POIMA_RUNTIME_RENDER_SMOKE@,
    "audio": @POIMA_RUNTIME_AUDIO@,
    "managed": @POIMA_RUNTIME_MANAGED_GAMEPLAY@,
    "native_gameplay": @POIMA_RUNTIME_NATIVE_GAMEPLAY@,
    "game_ui": @POIMA_RUNTIME_GAME_UI@,
    "editor": @POIMA_RUNTIME_EDITOR@
  }
}
