{
  "format": "poima.runtime",
  "version": 1,
  "engine_version": "@PROJECT_VERSION@",
  "gameplay_services_version": 7,
  "gameplay_call_version": 1,
  "gameplay_call_bytes": 80,
  "gameplay_services_bytes": @POIMA_RUNTIME_GAMEPLAY_SERVICES_BYTES@,
  "gameplay_features": [@POIMA_RUNTIME_GAMEPLAY_FEATURES@],
  "target_os": "@CMAKE_SYSTEM_NAME@",
  "target_arch": "@POIMA_TARGET_ARCH@",
  "executable": "bin/poima@CMAKE_EXECUTABLE_SUFFIX@",
  "features": {
    "asset_provenance": true,
    "simulation": @POIMA_RUNTIME_SIMULATION@,
    "physics_checkpoint": @POIMA_RUNTIME_SIMULATION@,
    "water_regions": @POIMA_RUNTIME_SIMULATION@,
    "snow_water_regions": @POIMA_RUNTIME_SIMULATION@,
    "water_rain": @POIMA_RUNTIME_SIMULATION@,
    "water_ripples": @POIMA_RUNTIME_RENDER_SMOKE@,
    "water_wave_layers": @POIMA_RUNTIME_WATER_WAVE_LAYERS@,
    "water_optics": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_sheets": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_sheet_aeration": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_impact_foam": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_refraction": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_caustics": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_shore_foam": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_terrain_fit": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_surface_swell": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_swell_variation": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_rough_reflection": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_solar_scattering": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_sun_shafts": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_offshore": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_sprite_optics": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_listener_audio": @POIMA_RUNTIME_SIMULATION_AUDIO@,
    "audio_water_flow": @POIMA_RUNTIME_SIMULATION_AUDIO@,
    "scene_particles": @POIMA_RUNTIME_SIMULATION@,
    "surface_marks": @POIMA_RUNTIME_SIMULATION@,
    "surface_mark_masks": @POIMA_RUNTIME_SURFACE_MARK_MASKS@,
    "scene_particle_sprites": @POIMA_RUNTIME_SCENE_PARTICLE_SPRITES@,
    "particle_collisions": @POIMA_RUNTIME_SIMULATION@,
    "particle_impact_bursts": @POIMA_RUNTIME_SIMULATION@,
    "particle_water_contact": @POIMA_RUNTIME_SIMULATION@,
    "particle_water_flow": @POIMA_RUNTIME_SIMULATION@,
    "water_buoyancy": @POIMA_RUNTIME_SIMULATION@,
    "water_currents": @POIMA_RUNTIME_SIMULATION@,
    "water_surface_wakes": @POIMA_RUNTIME_WATER_OPTICS@,
    "water_body_displacement": @POIMA_RUNTIME_SIMULATION@,
    "water_storage": @POIMA_RUNTIME_SIMULATION@,
    "water_reservoirs": @POIMA_RUNTIME_SIMULATION@,
    "water_overflow": @POIMA_RUNTIME_SIMULATION@,
    "collision_surfaces": @POIMA_RUNTIME_SIMULATION@,
    "renderer": @POIMA_RUNTIME_RENDER_SMOKE@,
    "fsr3_upscaler": @POIMA_RUNTIME_FSR3_UPSCALER@,
    "mesh_lod": @POIMA_RUNTIME_RENDER_SMOKE@,
    "project_post_effects": @POIMA_RUNTIME_RENDER_SMOKE@,
    "output_grade": @POIMA_RUNTIME_RENDER_SMOKE@,
    "tone_mapping": @POIMA_RUNTIME_RENDER_SMOKE@,
    "screen_reflections": @POIMA_RUNTIME_RENDER_SMOKE@,
    "depth_of_field": @POIMA_RUNTIME_RENDER_SMOKE@,
    "auto_exposure": @POIMA_RUNTIME_RENDER_SMOKE@,
    "atmosphere_sky": @POIMA_RUNTIME_ATMOSPHERE_SKY@,
    "orbital_atmosphere": @POIMA_RUNTIME_ATMOSPHERE_SKY@,
    "aerial_perspective": @POIMA_RUNTIME_AERIAL_PERSPECTIVE@,
    "volumetric_clouds": @POIMA_RUNTIME_VOLUMETRIC_CLOUDS@,
    "cloud_shadows": @POIMA_RUNTIME_CLOUD_SHADOWS@,
    "foliage_motion": @POIMA_RUNTIME_RENDER_SMOKE@,
    "height_fog": @POIMA_RUNTIME_RENDER_SMOKE@,
    "audio": @POIMA_RUNTIME_AUDIO@,
    "audio_room_reverb": @POIMA_RUNTIME_SIMULATION_AUDIO@,
    "audio_portals": @POIMA_RUNTIME_SIMULATION_AUDIO@,
    "player_early_reflections": @POIMA_RUNTIME_PLAYER_EARLY_REFLECTIONS@,
    "managed": @POIMA_RUNTIME_MANAGED_GAMEPLAY@,
    "native_gameplay": @POIMA_RUNTIME_NATIVE_GAMEPLAY@,
    "game_ui": @POIMA_RUNTIME_GAME_UI@,
    "navigation": @POIMA_RUNTIME_NAVIGATION@,
    "navigation_obstacles": @POIMA_RUNTIME_NAVIGATION@,
    "editor": @POIMA_RUNTIME_EDITOR@
  }
}
